# Copy to .env (never commit it) and fill in every value marked REQUIRED.

# --- Public address of the site (REQUIRED). Used for CORS and for links in emails.
PUBLIC_URL=https://talab.pk
WEB_PORT=8081

# --- Database. Postgres (default) uses the bundled container; only DB_PASSWORD is needed.
DB_PASSWORD=change-me-to-a-long-random-password   # REQUIRED
# SQL Server instead:
# DB_PROVIDER=SqlServer
# DB_CONNECTION=Server=mssql;Database=talab;User Id=sa;Password=<same as DB_PASSWORD>;TrustServerCertificate=True

# --- Secrets (REQUIRED)
# JWT_KEY: random, 32+ characters. Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_KEY=
# Google OAuth Web client ID (Google Cloud Console > Credentials). Add PUBLIC_URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# The first admin. Sign in with this Google account to reach /admin.
ADMIN_EMAIL=

# --- Email (optional but recommended; without SMTP_HOST emails are only written to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Talab <no-reply@talab.pk>

# --- Map tiles. The public OpenStreetMap server is NOT for real traffic: use a provider or your own tile server.
TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
TILE_MAX_ZOOM=20
