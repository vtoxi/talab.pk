<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the API. The publish step adds the ASP.NET Core handler to this file.
  Live chat needs the IIS feature "WebSocket Protocol" installed on the server (it is on by default once installed).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering removeServerHeader="true">
        <!-- three CNIC photos of up to 5 MB each, plus form overhead -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
